---
// The consignment label stuck on a piece: article, contents, COD amount,
// delivery days and a barcode. The ADDED stamp lands on it after Add to parcel.
import Barcode from './Barcode.astro';
import { delivery } from '../data/store.js';
import { rupees, typeLine } from '../lib/store.js';

interface Props {
  product: any;
  class?: string;
  // On phones, keep only the COD amount, delivery days and barcode.
  compact?: boolean;
}
const { product: p, class: className, compact = false } = Astro.props;
const lhe = delivery.find((d) => d.code === 'LHE')!;
const khi = delivery.find((d) => d.code === 'KHI')!;
---

<div class:list={['label', className, { compact }]} data-label>
  <p class="label-head">
    <span>Cash on delivery</span>
    <span class="data">MB/{p.code.slice(3)}</span>
  </p>
  <dl class="label-fields">
    <div>
      <dt class="field-label">Article</dt>
      <dd class="data">{p.code}</dd>
    </div>
    <div>
      <dt class="field-label">Contents</dt>
      <dd>{typeLine(p)}</dd>
    </div>
    <div class="label-cod">
      <dt class="visually-hidden">Price</dt>
      <dd>
        <span class="cod">
          <span class="field-label">COD amount</span>
          <span class="amount">{p.salePrice && <s>{rupees(p.price)}</s>}{rupees(p.salePrice ?? p.price)}</span>
        </span>
      </dd>
    </div>
    <div>
      <dt class="field-label">Delivery</dt>
      <dd class="data label-days">
        <span>{lhe.code} {lhe.days} days</span>
        <span>{khi.code} {khi.days} days</span>
      </dd>
    </div>
  </dl>
  <Barcode code={p.code} height={30} />
  <span class="stamp label-added" data-added-stamp hidden aria-hidden="true">Added</span>
</div>

<style>
  .label {
    position: relative;
    display: grid;
    gap: var(--space-3);
    width: min(320px, 100%);
    padding: 0 var(--space-4) var(--space-4);
    background: var(--white);
    border: 1.5px solid var(--form);
    box-shadow: var(--lift);
    transform: rotate(-2deg);
  }

  .label-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0 calc(var(--space-4) * -1);
    padding: var(--space-1) var(--space-4);
    background: var(--form);
    color: var(--white);
    font-family: var(--font-form);
    font-weight: 800;
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .label-head .data {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
  }

  .label-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--form-line);
  }

  .label-fields > div {
    padding: var(--space-2) var(--space-2) var(--space-2) 0;
    border-bottom: 1px solid var(--form-line);
  }

  .label-fields > div:nth-child(even) {
    padding-left: var(--space-3);
    border-left: 1px solid var(--form-line);
  }

  .label-fields dd {
    margin: 2px 0 0;
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.3;
  }

  .label-cod dd {
    margin: 0;
  }

  .label-cod .amount {
    font-size: var(--step-1);
  }

  .label-days {
    display: grid;
    font-size: var(--step--2) !important;
  }

  .label :global(.barcode) {
    width: 100%;
  }

  @media (max-width: 900px) {
    .compact {
      width: min(210px, 62%);
      gap: var(--space-2);
      padding: 0 var(--space-3) var(--space-3);
    }

    .compact .label-head {
      margin-inline: calc(var(--space-3) * -1);
      padding: 2px var(--space-3);
      font-size: var(--step--2);
    }

    .compact .label-head .data {
      display: none;
    }

    .compact .label-fields {
      grid-template-columns: 1fr;
    }

    .compact .label-fields > div:nth-child(-n + 2) {
      display: none;
    }

    .compact .label-fields > div:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }

    .compact .label-days {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-3);
    }

    .compact :global(.barcode svg) {
      height: 20px !important;
    }

  }

  /* Lands over the barcode, so the price and days stay readable. */
  .label-added {
    position: absolute;
    right: 7%;
    bottom: 9%;
    background: rgb(255 255 255 / 0.9);
    color: var(--pay);
    font-size: var(--step-2);
    transform: rotate(-14deg);
    mix-blend-mode: normal;
    animation: stamp-in 380ms var(--ease-out) both;
  }

  @keyframes stamp-in {
    from {
      opacity: 0;
      transform: rotate(-14deg) scale(1.6);
    }
    to {
      opacity: 0.9;
      transform: rotate(-14deg) scale(1);
    }
  }
</style>
