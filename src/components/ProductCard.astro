---
// One piece in the collection: the photo, its stamps, and a small tag with the
// article code, name, contents and the COD amount.
import { rupees, typeLine, unitPrice } from '../lib/store.js';

interface Props {
  product: any;
  eager?: boolean;
  index?: number;
}
const { product: p, eager = false, index = 0 } = Astro.props;
const soldOut = p.stock === 0;
const stockNote = soldOut ? 'Back in 2 weeks' : p.stock < 4 ? `Only ${p.stock} left` : '';
---

<li class="card" data-piece={p.slug} data-collection={p.collection} data-price={unitPrice(p)} data-order={index} data-stock={p.stock} data-sale={p.salePrice ? '1' : '0'}>
  <a class="card-link" href={`/p/${p.slug}/`}>
    <div class="card-photo">
      <img
        src={`/photos/${p.slug}-600.webp`}
        srcset={`/photos/${p.slug}-600.webp 600w, /photos/${p.slug}-1200.webp 1200w`}
        sizes="(min-width: 1100px) 300px, (min-width: 700px) 30vw, 46vw"
        width="600"
        height="900"
        alt={p.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      {soldOut && <span class="stamp ink card-stamp">Sold out</span>}
      {!soldOut && p.salePrice && <span class="stamp card-stamp">Sale</span>}
      {!soldOut && !p.salePrice && p.isNew && <span class="stamp card-stamp">New</span>}
    </div>
    <div class="card-tag">
      <span class="card-code data">{p.code}</span>
      <h3>{p.name}</h3>
      <p class="card-type">{typeLine(p)}</p>
      <p class="card-foot">
        <span class="cod card-cod">
          <span class="amount">{p.salePrice && <s>{rupees(p.price)}</s>}{rupees(unitPrice(p))}</span>
        </span>
        {stockNote && <span class="card-stock">{stockNote}</span>}
      </p>
    </div>
  </a>
</li>

<style>
  .card {
    position: relative;
  }

  .card-link {
    display: grid;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .card-link:focus-visible {
    outline-offset: 4px;
  }

  .card-photo {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--slip-deep);
  }

  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  @media (hover: hover) {
    .card-link:hover .card-photo img {
      transform: scale(1.03);
    }

    .card-link:hover h3 {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.15em;
    }
  }

  .card-stamp {
    position: absolute;
    top: var(--space-4);
    right: var(--space-3);
    background: rgb(255 255 255 / 0.88);
    font-size: var(--step-0);
    mix-blend-mode: normal;
  }

  .card-tag {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-2);
    border-top: var(--rule);
  }

  .card-code {
    font-size: var(--step--2);
    color: var(--form);
    letter-spacing: 0.12em;
  }

  .card-tag h3 {
    font-size: var(--step-1);
  }

  .card-type {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-1);
  }

  .card-cod {
    padding: 2px var(--space-2);
  }

  .card-cod .amount {
    font-size: var(--step--1);
  }

  .card-stock {
    font-size: var(--step--2);
    font-weight: 600;
  }
</style>
