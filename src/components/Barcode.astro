---
// A barcode drawn from the article code, with the code printed under it.
import { barcode } from '../lib/store.js';

interface Props {
  code: string;
  height?: number;
  class?: string;
}
const { code, height = 34, class: className } = Astro.props;
const { bars, width } = barcode(code);
---

<span class:list={['barcode', className]}>
  <svg viewBox={`0 0 ${width} 10`} preserveAspectRatio="none" style={`height: ${height}px`} aria-hidden="true" focusable="false">
    {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="10" />)}
  </svg>
  <span class="barcode-code data">{code}</span>
</span>

<style>
  .barcode {
    display: inline-grid;
    gap: 2px;
    justify-items: start;
  }

  svg {
    width: 100%;
    min-width: 120px;
    fill: var(--ink);
  }

  .barcode-code {
    font-size: var(--step--2);
    letter-spacing: 0.18em;
  }
</style>
